        {
          "name": "Register Chauffeur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', response.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', response.refreshToken);",
                  "    pm.collectionVariables.set('userId', response.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mohamed Alami\",\n  \"email\": \"mohamed@chauffeur.com\",\n  \"password\": \"chauffeur123\",\n  \"phoneNumber\": \"0612345678\",\n  \"nationalId\": \"AB123456\",\n  \"licenseNumber\": \"LIC123456\",\n  \"licenseType\": \"C\",\n  \"address\": \"123 Rue Mohammed V, Casablanca\",\n  \"dateOfBirth\": \"1985-05-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new chauffeur. Account will be pending until admin approves it. Note: role field is removed, registration is only for chauffeurs."
          },
          "response": []
        },
        {
          "name": "Login Admin",
